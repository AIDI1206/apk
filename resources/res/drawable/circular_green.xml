<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="22dp"
        android:width="22dp"
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/circle_view_green"/>
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape
            android:shape="ring"
            android:useLevel="false"
            android:innerRadius="10dp"
            android:thickness="10dp">
            <size
                android:height="32dp"
                android:width="32dp"/>
            <solid android:color="@color/logout_background"/>
        </shape>
    </item>
</layer-list>
