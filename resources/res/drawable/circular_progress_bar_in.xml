<?xml version="1.0" encoding="utf-8"?>
<rotate xmlns:android="http://schemas.android.com/apk/res/android" android:toDegrees="360">
    <shape
        android:shape="ring"
        android:innerRadiusRatio="5"
        android:useLevel="true"
        android:thickness="4dp">
        <gradient
            android:startColor="#007dd6"
            android:endColor="#00007dd6"
            android:useLevel="false"
            android:angle="0"
            android:type="sweep"/>
    </shape>
</rotate>
