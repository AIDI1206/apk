<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape>
                    <stroke
                        android:width="2dp"
                        android:color="@color/normal_mode_ui_color"/>
                    <solid android:color="@color/normal_mode_ui_color"/>
                    <padding
                        android:left="4dp"
                        android:top="4dp"
                        android:right="4dp"
                        android:bottom="4dp"/>
                </shape>
            </item>
            <item>
                <bitmap
                    android:gravity="center"
                    android:src="@android:drawable/arrow_down_float"
                    android:tint="@color/black"/>
            </item>
        </layer-list>
    </item>
</selector>
