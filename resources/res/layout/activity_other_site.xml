<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewer_coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/frameLayout1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/main_contents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linearLayout2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/search_contents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        app:layout_behavior="com.medicmedia.medilink.util.FTBOrigineBhavior">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linearLayout4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:layout_gravity="end|bottom"
                android:id="@+id/bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="14dp"
                android:src="@drawable/icon_search_medilink"/>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:layout_gravity="end|bottom"
                android:id="@+id/top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="14dp"
                app:srcCompat="@drawable/icon_search_google"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:gravity="center_vertical"
            android:id="@+id/innerquery_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="#e0525252"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/logout_background"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/contents_query_highlight"
                    android:layout_weight="0"
                    android:paddingStart="8dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/logout_background"
                    android:gravity="center_vertical"
                    android:id="@+id/innerquery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="4dp"/>
                <TextView
                    android:id="@+id/innercount"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/inner_search_delete"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:layout_marginEnd="4dp"
                    app:srcCompat="@drawable/ic_baseline_highlight_off_24px"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/AppTheme.AppBarOverlay"
        android:id="@+id/appbar"
        android:background="#eff0f0"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <RelativeLayout
            android:id="@+id/activity_search_view_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:background="#eff0f0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize"
                app:theme="@style/ToolbarStyle"
                app:titleMarginStart="2dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/toolbar_inner_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.cardview.widget.CardView
                            android:id="@+id/navigation_dashboard_card"
                            android:visibility="gone"
                            android:layout_width="30dp"
                            android:layout_height="match_parent"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:layout_marginEnd="10dp"
                            app:cardBackgroundColor="#00cfcfcf"
                            app:cardCornerRadius="4dp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_gravity="end"
                                android:id="@+id/navigation_dashboard"
                                android:layout_width="30dp"
                                android:layout_height="40dp"
                                android:foreground="?android:attr/selectableItemBackground"
                                android:src="@drawable/ic_arrow_back_ios_24px"
                                android:scaleType="centerInside"
                                android:paddingEnd="10dp"
                                android:transitionName="@string/master_to_detail_trans_name"/>
                        </androidx.cardview.widget.CardView>
                        <androidx.cardview.widget.CardView
                            android:id="@+id/thumb_view"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:foreground="?android:attr/selectableItemBackground"
                            app:cardBackgroundColor="#cfcfcf"
                            app:cardCornerRadius="4dp"
                            app:cardElevation="0dp">
                            <androidx.cardview.widget.CardView
                                android:layout_gravity="center"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:foreground="?android:attr/selectableItemBackground"
                                app:cardCornerRadius="3dp"
                                app:cardElevation="0dp">
                                <ImageView
                                    android:layout_gravity="end"
                                    android:id="@+id/toolbar_image"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/ic_baseline_bookmark_24px"
                                    android:scaleType="centerCrop"
                                    android:transitionName="@string/master_to_detail_trans_name"/>
                            </androidx.cardview.widget.CardView>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/toolbar_title_field"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="4dp">
                            <TextView
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:textColor="@color/background_black"
                                android:ellipsize="end"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/toolbar_title"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/viewer_title_loading"
                                android:maxLines="1"
                                android:layout_weight="1"
                                android:layout_marginEnd="14dp"
                                style="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"/>
                            <TextView
                                android:textSize="14dp"
                                android:textColor="@color/background_black"
                                android:ellipsize="middle"
                                android:gravity="center_vertical"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/toolbar_sub_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/viewer_title_loading"
                                android:singleLine="true"
                                android:layout_weight="1"
                                android:layout_marginEnd="14dp"
                                style="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.appcompat.widget.Toolbar>
            <include
                android:visibility="gone"
                layout="@layout/search_note_toolbar"/>
            <include
                android:visibility="gone"
                layout="@layout/search_contents_toolbar"/>
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <com.medicmedia.medilink.util.CustomBottomNavigationView
        android:layout_gravity="bottom"
        android:id="@+id/navigation"
        android:background="@color/normal_mode_ui_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:menu="@menu/navigation"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
