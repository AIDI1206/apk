<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fragment_history_menu_bottom"
    android:background="#eff0f0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:behavior_hideable="false"
    app:behavior_peekHeight="0dp"
    app:layout_behavior="@string/bottom_sheet_behavior">
    <View
        android:layout_gravity="bottom"
        android:background="#80efefef"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <Spinner
        android:id="@+id/spinner2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#eff0f0"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:weightSum="2"
        android:layout_weight="0">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/background_black"
            android:gravity="center"
            android:id="@+id/textView5"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="start"
            android:id="@+id/filter_back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:foreground="?android:attr/selectableItemBackground"
            android:rotation="-90"
            app:cardElevation="0dp">
            <ImageView
                android:background="#eff0f0"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/ic_round_arrow_back_ios_24px"/>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:id="@+id/delete_normal_menu"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.google.android.material.button.MaterialButton
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/background_black"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/rate_dialog_button_neutral"
                android:paddingLeft="8dp"
                android:paddingTop="@dimen/rate_dialog_zero_dp"
                android:paddingRight="8dp"
                android:paddingBottom="@dimen/rate_dialog_zero_dp"
                android:focusable="true"
                android:visibility="visible"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="@dimen/rate_dialog_zero_dp"
                android:layout_marginBottom="@dimen/rate_dialog_zero_dp"
                android:text="@string/back_to_memo_page"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="14dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/button4"
                android:layout_width="46dp"
                android:layout_height="match_parent"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_marginEnd="6dp"
                app:cardElevation="0dp">
                <ImageView
                    android:background="#eff0f0"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/ic_baseline_delete_24px_black"/>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_gravity="end"
                android:id="@+id/button2"
                android:layout_width="46dp"
                android:layout_height="match_parent"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_marginEnd="6dp"
                app:cardElevation="0dp">
                <ImageView
                    android:background="#eff0f0"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/ic_baseline_check_circle_24px"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/delete_comp_button"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">
            <com.google.android.material.button.MaterialButton
                android:textColor="#818080"
                android:id="@+id/delete_cansel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_delete_cansel"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="@color/logout_background"
                android:id="@+id/delete_do"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_delete_ok"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                app:backgroundTint="@color/background_login"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        </LinearLayout>
        <View
            android:layout_gravity="bottom"
            android:background="#80efefef"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </FrameLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="5dp"
        android:hint="@string/dialog_memo_hint"
        android:selectAllOnFocus="true"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.textfield.TextInputLayout>
    <View
        android:layout_gravity="bottom"
        android:background="#edeef2"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_weight="0"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/view2"
        android:background="#edeef2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_weight="0"/>
</LinearLayout>
