<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fragment_history_menu_bottom"
    android:background="@color/logout_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="android.support.design.widget.BottomSheetBehavior">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:id="@+id/textView3"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_download_comp_title"/>
    <TextView
        android:textSize="16sp"
        android:layout_gravity="center"
        android:id="@+id/download_comp_message"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_download_comp_title"/>
    <TextView
        android:textSize="16sp"
        android:layout_gravity="center"
        android:id="@+id/textView2"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_download_comp_title"/>
    <EditText
        android:id="@+id/edtSerial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Country Code"/>
    <CheckBox
        android:textColor="@color/background_black"
        android:layout_gravity="center_vertical"
        android:id="@+id/checkBox2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="24dp"
        android:text="@string/resume_checkbox"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:buttonTint="@color/checkbox_color"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.button.MaterialButton
            android:textColor="#474747"
            android:id="@+id/button5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/dialog_download_comp_cansel"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:backgroundTint="#c2c2c2"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/logout_background"
            android:id="@+id/button6"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/dialog_download_comp_read"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:backgroundTint="@color/button_login_color"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/logout_background"
            android:id="@+id/button7"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/dialog_resume_read"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:backgroundTint="@color/button_login_color"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
    </LinearLayout>
</LinearLayout>
