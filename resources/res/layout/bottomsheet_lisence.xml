<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bottom_sheet"
    android:background="#fff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:behavior_hideable="true"
    app:behavior_peekHeight="56dp"
    app:layout_behavior="com.medicmedia.medilink.TermOfServiceDialog.UserLockBottomSheetBehavior">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/textView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/dialog_lisence_title"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <WebView
            android:id="@+id/tearm_service_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:weightSum="2">
        <com.google.android.material.button.MaterialButton
            android:textColor="#585757"
            android:id="@+id/cansel_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/dialog_lisence_button_ng"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/logout_background"
            android:id="@+id/accsept_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/dialog_lisence_button_ok"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            app:backgroundTint="#2975dd"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
    </LinearLayout>
</LinearLayout>
