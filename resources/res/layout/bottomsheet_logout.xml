<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fragment_history_menu_bottom"
        android:background="@color/logout_background"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="20dp"
        app:layout_behavior="android.support.design.widget.BottomSheetBehavior">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/dialog_message"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_logout_title"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"/>
        <View
            android:layout_gravity="bottom"
            android:background="#80efefef"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_weight="0"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/fragment_bottom_logout_do"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:foreground="?android:attr/selectableItemBackground">
            <ImageView
                android:id="@+id/dialog_do_image"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/ic_menu_camera"/>
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/dialog_do_message"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:text="@string/dialog_logout_button_do"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/check_image"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:layout_weight="0"
                app:srcCompat="@drawable/ic_check_circle_outline_24px"/>
        </LinearLayout>
        <View
            android:layout_gravity="bottom"
            android:background="#80efefef"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_weight="0"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/fragment_bottom_logout_cansel"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:foreground="?android:attr/selectableItemBackground">
            <ImageView
                android:id="@+id/dialog_cansel_image"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/ic_baseline_delete_24px"/>
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/dialog_cansel_message"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:text="@string/dialog_logout_button_cancel"
                android:layout_weight="1"/>
            <ImageView
                android:gravity="bottom|right"
                android:id="@+id/check_image2"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:layout_weight="0"
                app:srcCompat="@drawable/ic_check_circle_outline_24px"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/progressBar_background"
        android:background="@color/logout_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="20dp">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressBar3"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:indeterminateTint="@color/button_login_color"
            style="?android:attr/progressTintMode"/>
    </LinearLayout>
</FrameLayout>
