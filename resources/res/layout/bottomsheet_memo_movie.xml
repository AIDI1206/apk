<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/movie_contents"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:behavior_hideable="false"
    app:behavior_peekHeight="0dp"
    app:layout_behavior="@string/bottom_sheet_behavior">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:weightSum="2"
        android:layout_weight="0">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/background_black"
            android:gravity="center"
            android:id="@+id/textView5"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="start"
            android:id="@+id/filter_back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardElevation="0dp">
            <ImageView
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/ic_round_arrow_back_ios_24px"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="end"
            android:id="@+id/filter_sort"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginRight="4dp"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/filter_sort_image"
                android:paddingLeft="6dp"
                android:paddingTop="0dp"
                android:paddingRight="6dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_sort_24px"/>
            <TextView
                android:textSize="8dp"
                android:textStyle="bold"
                android:textColor="@color/background_black"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/textView7"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginBottom="5dp"
                android:text="デフォルト"
                android:singleLine="true"
                android:layout_weight="1"/>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/delete_comp_button"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">
            <com.google.android.material.button.MaterialButton
                android:textColor="#818080"
                android:id="@+id/delete_cansel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_delete_cansel"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="@color/logout_background"
                android:id="@+id/delete_do"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_delete_ok"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                app:backgroundTint="@color/background_login"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        </LinearLayout>
        <View
            android:layout_gravity="bottom"
            android:background="#80efefef"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <View
            android:layout_gravity="top"
            android:background="#80efefef"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:hint="@string/dialog_memo_hint"
            android:selectAllOnFocus="true"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>
        <androidx.cardview.widget.CardView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/button4"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_weight="0"
            app:cardElevation="0dp">
            <ImageView
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/ic_baseline_check_circle_24px"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imageView"
            android:layout_centerHorizontal="true"
            android:indeterminateTint="@color/button_login_color"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gridView"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
