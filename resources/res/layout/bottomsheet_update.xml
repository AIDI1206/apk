<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bottom_sheet"
    android:background="#fff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:behavior_hideable="true"
    app:behavior_peekHeight="56dp"
    app:layout_behavior="com.medicmedia.medilink.TermOfServiceDialog.UserLockBottomSheetBehavior">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/dialog_lisence_title"/>
        <TextView
            android:textSize="14dp"
            android:gravity="center"
            android:id="@+id/update_message"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="26dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_lisence_title"
            android:layout_weight="0"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/rate_dialog_icon"
            android:background="@color/rateDialogColorTransparent"
            android:paddingLeft="@dimen/rate_dialog_zero_dp"
            android:paddingTop="@dimen/rate_dialog_zero_dp"
            android:paddingRight="@dimen/rate_dialog_zero_dp"
            android:paddingBottom="@dimen/rate_dialog_zero_dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rate_dialog_icon_dimensions"
            android:layout_marginLeft="@dimen/rate_dialog_zero_dp"
            android:layout_marginTop="@dimen/rate_dialog_zero_dp"
            android:layout_marginRight="@dimen/rate_dialog_zero_dp"
            android:layout_marginBottom="@dimen/rate_dialog_zero_dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription=""
            android:layout_marginStart="@dimen/rate_dialog_zero_dp"
            android:layout_marginEnd="@dimen/rate_dialog_zero_dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:weightSum="2"
        android:layout_weight="0">
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/logout_background"
            android:id="@+id/accsept_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/dialog_lisence_button_ok"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            app:backgroundTint="#2975dd"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
    </LinearLayout>
</LinearLayout>
