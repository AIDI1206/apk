<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:paddingRight="0dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="50dp">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/view1"
        android:background="#ffefefef"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="1dp"
        android:layout_weight="0"/>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="?android:attr/selectableItemBackground"
        card_view:cardCornerRadius="0dp"
        card_view:cardElevation="0dp">
        <FrameLayout
            android:id="@+id/card_frame_view"
            android:background="#b7c0e9"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <CheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/checkBox"
                    android:visibility="gone"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="12dp"
                    card_view:buttonTint="@color/checkbox_color"/>
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="#6971af"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/bookTitle1"
                    android:paddingLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:layout_gravity="bottom|center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/titleLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:paddingStart="20dp"
                    android:paddingEnd="4dp">
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#6971af"
                        android:ellipsize="end"
                        android:gravity="end|center_vertical"
                        android:id="@+id/bookTitle2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1/9動画視聴済"
                        android:maxLines="2"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#6971af"
                        android:ellipsize="end"
                        android:gravity="end|center_vertical"
                        android:id="@+id/bookTitle3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="視聴日：2020/03/01"
                        android:maxLines="2"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/expand_field"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="0">
                    <ImageView
                        android:id="@+id/image_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="12dp"
                        android:src="@drawable/ic_keyboard_arrow_up_black_24dp"
                        android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_gravity="center"
                android:id="@+id/masking"
                android:background="#80b9babf"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/view2"
            android:background="#ffefefef"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_weight="0"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>
