<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:paddingRight="0dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="end|center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/notPurchase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/accent_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/notPurchaseInText"
            android:background="@color/search_card_image_color"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_user_not_purchase"
            android:maxLines="1"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="end|center_vertical"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="74dp"
            android:layout_weight="1">
            <View
                android:id="@+id/blank"
                android:background="#00b9babf"
                android:visibility="invisible"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:minHeight="74dp"/>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:id="@+id/titleLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="74dp"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">
                <TextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:textColor="@color/background_black"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/bookTitle1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
                <com.medicmedia.medilink.util.AnimatingProgressBar
                    android:id="@+id/progressBarMovieCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:indeterminate="false"
                    android:minWidth="200dp"
                    android:minHeight="10dp"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/background_black"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:id="@+id/bookTitle2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"/>
                <androidx.cardview.widget.CardView
                    android:layout_gravity="center"
                    android:id="@+id/version_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_weight="0"
                    app:cardBackgroundColor="#ffdead"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/background_black"
                        android:ellipsize="end"
                        android:gravity="left"
                        android:id="@+id/version_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="testsssssssssssssssssssssssssssssssssssssssssssssss"
                        android:maxLines="2"
                        android:layout_weight="0"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:id="@+id/card_view_pdf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:minHeight="74dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/menuImagePdf"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:layout_width="46dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:layout_weight="0"
                    app:srcCompat="@drawable/ic_picture_as_pdf_24px"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <View
            android:layout_gravity="center"
            android:id="@+id/masking"
            android:background="#80b9babf"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/view2"
        android:background="#ffefefef"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="0dp"
        android:layout_weight="0"/>
</LinearLayout>
