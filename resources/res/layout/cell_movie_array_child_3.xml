<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:paddingRight="0dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/thumb_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:minHeight="74dp"
        android:layout_weight="1"
        android:layout_marginStart="42dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="#cfcfcf"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp">
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:minHeight="74dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            app:cardCornerRadius="3dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:gravity="end|center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingEnd="8dp">
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:layout_gravity="bottom|center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/titleLayout"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="14dp"
                            android:textStyle="bold"
                            android:textColor="@color/background_black"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/bookTitle1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:layout_weight="1"/>
                        <androidx.cardview.widget.CardView
                            android:layout_gravity="center"
                            android:id="@+id/version_view"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:layout_weight="0"
                            android:layout_marginStart="4dp"
                            app:cardBackgroundColor="#ffdead"
                            app:cardCornerRadius="4dp"
                            app:cardElevation="0dp">
                            <TextView
                                android:textSize="9dp"
                                android:textColor="@color/background_black"
                                android:ellipsize="end"
                                android:gravity="left"
                                android:id="@+id/version_text"
                                android:paddingBottom="1dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="100dp"
                                android:maxLines="2"
                                android:layout_weight="0"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"/>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <com.medicmedia.medilink.util.AnimatingProgressBar
                        android:id="@+id/progressBarMovieCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="0"
                        android:indeterminate="false"
                        android:minWidth="200dp"
                        android:minHeight="10dp"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/background_black"
                        android:ellipsize="end"
                        android:gravity="end|center_vertical"
                        android:id="@+id/bookTitle2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"/>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/menuImagePdf"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:visibility="gone"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:scaleType="centerInside"
                    android:layout_weight="0"
                    android:layout_marginEnd="4dp"
                    app:srcCompat="@drawable/ic_picture_as_pdf_24px"/>
            </LinearLayout>
            <View
                android:layout_gravity="center"
                android:id="@+id/masking"
                android:background="#80b9babf"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/view2"
        android:background="#ffefefef"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_weight="0"/>
</LinearLayout>
