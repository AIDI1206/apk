<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:paddingRight="0dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:foreground="?android:attr/selectableItemBackground"
        card_view:cardCornerRadius="0dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <CheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/checkBox"
                    android:visibility="gone"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="12dp"/>
                <FrameLayout
                    android:layout_gravity="center"
                    android:layout_width="150dp"
                    android:layout_height="90dp"
                    android:layout_weight="0">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/imgView"
                        android:layout_width="150dp"
                        android:layout_height="90dp"
                        android:scaleType="centerInside"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:textColor="@color/background_black"
                        android:gravity="center"
                        android:layout_gravity="start|top"
                        android:id="@+id/video_num_label"
                        android:background="@drawable/label_frame_movie"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/background_black"
                        android:gravity="center"
                        android:layout_gravity="end|bottom"
                        android:id="@+id/item_name"
                        android:background="@drawable/label_frame_movie"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"/>
                    <com.medicmedia.medilink.util.AnimatingProgressBar
                        android:layout_gravity="bottom"
                        android:id="@+id/progressBarMovieCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="0"
                        android:indeterminate="false"
                        android:minWidth="200dp"
                        android:minHeight="5dp"
                        style="?android:attr/progressBarStyleHorizontal"/>
                </FrameLayout>
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:layout_gravity="bottom|center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/titleLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <LinearLayout
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_weight="0">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/inner_imgView_done"
                            android:focusable="false"
                            android:visibility="gone"
                            android:layout_width="20dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_done_24px"
                            android:scaleType="centerInside"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="@color/background_black"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/bookTitle1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_weight="0">
                        <RatingBar
                            android:theme="@style/Gnt.RatingBar.Small"
                            android:id="@+id/ratingBar"
                            android:paddingTop="0dp"
                            android:layout_width="50dp"
                            android:layout_height="16dp"
                            android:max="3"
                            android:numStars="3"
                            android:stepSize="0.1"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            style="?android:attr/ratingBarStyleSmall"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#0060b4"
                            android:layout_gravity="end"
                            android:id="@+id/label"
                            android:background="@drawable/label_frame_cbt"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingBottom="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:text="CBT"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/background_black"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/bookTitle2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/background_black"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/bookTitle3"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_gravity="center"
                android:id="@+id/masking"
                android:background="#80b9babf"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/view2"
            android:background="#ffefefef"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="14dp"
            android:layout_weight="0"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>
