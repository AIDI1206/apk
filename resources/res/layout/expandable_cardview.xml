<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_layout"
    android:paddingTop="@dimen/default_vertical_padding"
    android:paddingBottom="@dimen/default_vertical_padding"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">
    <FrameLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/default_card_height">
        <View
            android:layout_gravity="top"
            android:id="@+id/view"
            android:background="#80efefef"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_weight="0"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/card_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_card_height">
            <ImageButton
                android:id="@+id/card_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@android:color/primary_text_light"
                android:id="@+id/card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@+id/card_icon"/>
        </RelativeLayout>
        <ViewStub
            android:id="@+id/card_stub"
            android:inflatedId="@+id/innerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"/>
        <ImageButton
            android:layout_gravity="right"
            android:id="@+id/card_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_keyboard_arrow_down_black_24dp"
            android:layout_marginEnd="12dp"/>
    </FrameLayout>
</androidx.cardview.widget.CardView>
