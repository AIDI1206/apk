<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="end|bottom"
    android:id="@+id/linearLayout3"
    android:background="@color/circle_view_ring"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    app:layout_behavior="com.medicmedia.medilink.util.FTBOrigineBhavior">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="end|bottom"
        android:background="@color/circle_view_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/shape_layout"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">
                <androidx.cardview.widget.CardView
                    android:id="@+id/myCardView"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/roundedimag"
                        android:background="@drawable/circular_selecter_red"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/shape_layout2"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">
                <androidx.cardview.widget.CardView
                    android:id="@+id/myCardView2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/roundedimag2"
                        android:background="@drawable/circular_selecter_yellow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/shape_layout3"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">
                <androidx.cardview.widget.CardView
                    android:id="@+id/myCardView3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/roundedimag3"
                        android:background="@drawable/circular_selecter_green"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/shape_layout4"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">
                <androidx.cardview.widget.CardView
                    android:id="@+id/myCardView4"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/roundedimag4"
                        android:background="@drawable/circular_selecter_blue"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/shape_layout5"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">
                <androidx.cardview.widget.CardView
                    android:id="@+id/myCardView5"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/roundedimag5"
                        android:background="@drawable/circular_selecter_delete"
                        android:padding="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_icon_r_0405"
                        android:scaleType="centerInside"/>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/shape_layout6"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">
                <androidx.cardview.widget.CardView
                    android:id="@+id/myCardView6"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="16dp">
                    <ImageView
                        android:id="@+id/roundedimag6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/cansel_button"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_margin="8dp"
        android:layout_weight="0"
        app:srcCompat="@drawable/ic_baseline_cancel_24px"/>
</FrameLayout>
