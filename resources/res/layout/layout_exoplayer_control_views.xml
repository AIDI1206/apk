<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#99000000"
    android:paddingTop="10dp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/myCardView2"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="14dp"
        android:backgroundTint="@color/background_black"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/movie_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_round_arrow_back_24"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/video_layut_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@+id/myCardView2">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/header_tv"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Funny Anim Videossfasdfsfdsafdsfsdafdsfsdfafdsaf"
            android:maxLines="2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/header_subtv"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Funny Anim Videossfasdfsfdsafdsfsdafdsfsdfafdsaf"
            android:maxLines="2"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/setting_movie"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="2dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/ic_settings_white_18dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="10dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pip_movie"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="2dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/ic_picture_in_picture_alt_white_18dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="10dp"
        app:layout_constraintRight_toLeftOf="@+id/setting_movie"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/list_movie"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="2dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/ic_round_menu_24px"
        android:scaleType="centerCrop"
        android:layout_marginEnd="10dp"
        app:layout_constraintRight_toLeftOf="@+id/pip_movie"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="exo_pause,exo_play"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_left2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="exo_rew_layout"/>
    <FrameLayout
        android:id="@+id/exo_rew_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play"
        app:layout_constraintRight_toLeftOf="@+id/barrier_left"
        app:layout_constraintTop_toTopOf="@+id/exo_play">
        <ImageButton
            android:id="@+id/exo_rew"
            android:visibility="visible"
            android:src="0x7f08015a"
            app:layout_constraintBottom_toBottomOf="@+id/exo_play"
            app:layout_constraintRight_toLeftOf="@+id/barrier_left"
            app:layout_constraintTop_toTopOf="@+id/exo_play"
            style="@style/ExoMediaButton.Rewind"/>
        <TextView
            android:textSize="8dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/seccond_label_rew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"/>
    </FrameLayout>
    <ImageButton
        android:id="@+id/exo_prev"
        android:visibility="visible"
        android:layout_marginRight="0dp"
        android:src="0x7f0801a4"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play"
        app:layout_constraintRight_toLeftOf="@+id/barrier_left2"
        app:layout_constraintTop_toTopOf="@+id/exo_play"
        style="@style/ExoMediaButton.Previous"/>
    <FrameLayout
        android:id="@+id/exo_ffwd_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play"
        app:layout_constraintLeft_toRightOf="@+id/barrier_right"
        app:layout_constraintTop_toTopOf="@+id/exo_play">
        <ImageButton
            android:id="@+id/exo_ffwd"
            android:visibility="visible"
            android:src="0x7f080157"
            app:layout_constraintBottom_toBottomOf="@+id/exo_play"
            app:layout_constraintLeft_toRightOf="@+id/barrier_right"
            app:layout_constraintTop_toTopOf="@+id/exo_play"
            style="@style/ExoMediaButton.FastForward"/>
        <TextView
            android:textSize="8dp"
            android:textColor="@color/logout_background"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/seccond_label_ffwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="50dp"
            android:layout_weight="0"
            app:layout_constraintEnd_toEndOf="@+id/exo_ffwd"
            app:layout_constraintStart_toStartOf="@+id/exo_ffwd"
            app:layout_constraintTop_toBottomOf="@+id/exo_ffwd"/>
    </FrameLayout>
    <ImageButton
        android:id="@+id/exo_next"
        android:visibility="visible"
        android:layout_marginLeft="0dp"
        android:src="0x7f0801a1"
        app:layout_constraintBottom_toBottomOf="@+id/exo_play"
        app:layout_constraintLeft_toRightOf="@+id/barrier_right2"
        app:layout_constraintTop_toTopOf="@+id/exo_play"
        style="@style/ExoMediaButton.Next"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_right2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="right"
        app:constraint_referenced_ids="exo_ffwd_layout"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="right"
        app:constraint_referenced_ids="exo_pause,exo_play"/>
    <ImageButton
        android:id="@+id/exo_play"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f080159"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ExoMediaButton.Play"/>
    <ImageButton
        android:id="@+id/exo_pause"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="0x7f080158"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ExoMediaButton.Pause"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/videoTimeContainerLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/videoTimeContainer"
        app:layout_constraintEnd_toEndOf="@+id/videoTimeContainer"
        app:layout_constraintStart_toStartOf="@+id/videoTimeContainer">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/logout_background"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="50dp"
            android:layout_weight="0"/>
        <View
            android:textSize="14sp"
            android:textColor="@color/logout_background"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/exo_position"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:minWidth="50dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/logout_background"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/play_speed"
            android:background="@drawable/label_frame_movie_speed"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="50dp"
            android:layout_weight="0"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/logout_background"
            android:gravity="end"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="50dp"
            android:layout_weight="0"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/repeat_im"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/repeat_one_fill0_wght400_grad0_opsz48"
            android:scaleType="centerCrop"
            android:layout_weight="0"
            android:layout_marginStart="10dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/cross_im"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_fullscreen_white_18dp"
            android:scaleType="centerCrop"
            android:layout_weight="0"
            android:layout_marginStart="10dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/info_display"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="3dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_info_white_24dp"
            android:scaleType="centerCrop"
            android:layout_weight="0"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/videoTimeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.exoplayer2.ui.DefaultTimeBar
            android:layout_gravity="center"
            android:id="@+id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:buffered_color="@color/white_50"
            app:played_color="@color/background_login"
            app:scrubber_color="@color/background_login"
            app:unplayed_color="@color/white_20"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/logout_background"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/movie_list_horizontal"
            android:background="@drawable/label_frame_movie_speed"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minWidth="50dp"
            android:layout_weight="0"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="18dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/logout_background"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/exo_go_live"
            android:background="@drawable/bg_round_rect_white_50"
            android:paddingLeft="15dp"
            android:paddingTop="6dp"
            android:paddingRight="15dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="50dp"
            android:minHeight="25dp"
            android:minEms="4"
            app:layout_constraintBottom_toBottomOf="@+id/exo_progress"
            app:layout_constraintStart_toEndOf="@+id/exo_progress"
            app:layout_constraintTop_toTopOf="@+id/exo_progress"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/horizontal_view"
            android:background="#00efefef"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_weight="0"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/list_movie3"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="2dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/ic_round_menu_24px"
        android:scaleType="centerCrop"
        app:layout_constraintRight_toLeftOf="@+id/list_movie"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
