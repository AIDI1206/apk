<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/logout_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="800dp"
    android:minWidth="300dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="#11000000"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/black_50"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="16dp"
            android:text="@string/search_filter_pop_title"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_gravity="start"
                android:id="@+id/label_view"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/search_card_index_color"
                app:cardCornerRadius="5dp"
                app:cardElevation="0dp">
                <TextView
                    android:textSize="8dp"
                    android:textColor="@color/search_card_index_text_color"
                    android:gravity="center"
                    android:id="@+id/label"
                    android:padding="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_mode1"
                    android:layout_weight="1"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/black_50"
                android:gravity="start"
                android:id="@+id/label_title"
                android:paddingLeft="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_filter_title"
                android:layout_weight="0"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/black_50"
            android:gravity="start"
            android:id="@+id/label_des"
            android:paddingLeft="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/search_filter_title_message"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_gravity="start"
                android:id="@+id/label_view2"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/search_card_all_color"
                app:cardCornerRadius="5dp"
                app:cardElevation="0dp">
                <TextView
                    android:textSize="8dp"
                    android:textColor="@color/search_card_all_text_color"
                    android:gravity="center"
                    android:id="@+id/label2"
                    android:padding="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_mode2"
                    android:layout_weight="1"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/black_50"
                android:gravity="start"
                android:id="@+id/label_title2"
                android:paddingLeft="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_filter_title_2"
                android:layout_weight="0"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/black_50"
            android:gravity="start"
            android:id="@+id/label_des2"
            android:paddingLeft="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_filter_title_message_2"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#bb000000"
            android:gravity="start"
            android:id="@+id/label_des3"
            android:paddingLeft="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/search_filter_title_message_3"
            android:layout_weight="0"/>
    </LinearLayout>
</LinearLayout>
