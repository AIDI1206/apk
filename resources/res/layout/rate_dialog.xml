<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rate_dialog_layout_root"
    android:paddingLeft="@dimen/rate_dialog_zero_dp"
    android:paddingTop="@dimen/rate_dialog_zero_dp"
    android:paddingRight="@dimen/rate_dialog_zero_dp"
    android:paddingBottom="@dimen/rate_dialog_zero_dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="ifContentScrolls">
    <RelativeLayout
        android:orientation="vertical"
        android:background="@color/rateDialogColorTransparent"
        android:paddingLeft="@dimen/rate_dialog_zero_dp"
        android:paddingTop="@dimen/rate_dialog_zero_dp"
        android:paddingRight="@dimen/rate_dialog_zero_dp"
        android:paddingBottom="@dimen/rate_dialog_zero_dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/rate_dialog_zero_dp"
        android:layout_marginTop="@dimen/rate_dialog_zero_dp"
        android:layout_marginRight="@dimen/rate_dialog_zero_dp"
        android:layout_marginBottom="@dimen/rate_dialog_zero_dp"
        android:layout_marginStart="@dimen/rate_dialog_zero_dp"
        android:layout_marginEnd="@dimen/rate_dialog_zero_dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/rate_dialog_layout_head"
            android:background="@drawable/rate_dialog_rectangle_rounded_top"
            android:paddingLeft="@dimen/rate_dialog_zero_dp"
            android:paddingTop="@dimen/rate_dialog_ten_dp"
            android:paddingRight="@dimen/rate_dialog_zero_dp"
            android:paddingBottom="@dimen/rate_dialog_ten_dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/rate_dialog_zero_dp"
            android:layout_marginTop="@dimen/rate_dialog_zero_dp"
            android:layout_marginRight="@dimen/rate_dialog_zero_dp"
            android:layout_marginBottom="@dimen/rate_dialog_zero_dp"
            android:layout_marginStart="@dimen/rate_dialog_zero_dp"
            android:layout_marginEnd="@dimen/rate_dialog_zero_dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/rate_dialog_icon"
                android:background="@color/rateDialogColorTransparent"
                android:paddingLeft="@dimen/rate_dialog_zero_dp"
                android:paddingTop="@dimen/rate_dialog_zero_dp"
                android:paddingRight="@dimen/rate_dialog_zero_dp"
                android:paddingBottom="@dimen/rate_dialog_zero_dp"
                android:layout_width="@dimen/rate_dialog_icon_dimensions"
                android:layout_height="@dimen/rate_dialog_icon_dimensions"
                android:layout_marginLeft="@dimen/rate_dialog_zero_dp"
                android:layout_marginTop="@dimen/rate_dialog_zero_dp"
                android:layout_marginRight="@dimen/rate_dialog_zero_dp"
                android:layout_marginBottom="@dimen/rate_dialog_zero_dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription=""
                android:layout_marginStart="@dimen/rate_dialog_zero_dp"
                android:layout_marginEnd="@dimen/rate_dialog_zero_dp"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/background_black"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/rate_dialog_text_dialog_title"
                android:background="@color/rateDialogColorTransparent"
                android:paddingLeft="@dimen/rate_dialog_zero_dp"
                android:paddingTop="@dimen/rate_dialog_zero_dp"
                android:paddingRight="@dimen/rate_dialog_zero_dp"
                android:paddingBottom="@dimen/rate_dialog_zero_dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/rate_dialog_zero_dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="@dimen/rate_dialog_zero_dp"
                android:layout_marginBottom="@dimen/rate_dialog_zero_dp"
                android:text="@string/rate_dialog_title"
                android:layout_marginStart="@dimen/rate_dialog_zero_dp"
                android:layout_marginEnd="@dimen/rate_dialog_zero_dp"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="normal"
                android:textColor="@color/background_black"
                android:gravity="left"
                android:layout_gravity="center_horizontal"
                android:id="@+id/rate_dialog_text_dialog_message"
                android:background="@color/rateDialogColorTransparent"
                android:paddingLeft="@dimen/rate_dialog_twenty_dp"
                android:paddingTop="@dimen/rate_dialog_zero_dp"
                android:paddingRight="@dimen/rate_dialog_twenty_dp"
                android:paddingBottom="@dimen/rate_dialog_zero_dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/rate_dialog_zero_dp"
                android:layout_marginTop="@dimen/rate_dialog_zero_dp"
                android:layout_marginRight="@dimen/rate_dialog_zero_dp"
                android:layout_marginBottom="@dimen/rate_dialog_zero_dp"
                android:text="@string/rate_dialog_message"
                android:layout_marginStart="@dimen/rate_dialog_zero_dp"
                android:layout_marginEnd="@dimen/rate_dialog_zero_dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/rate_dialog_layout_buttons"
            android:background="@color/rateDialogColorTransparent"
            android:paddingLeft="@dimen/rate_dialog_zero_dp"
            android:paddingTop="@dimen/rate_dialog_zero_dp"
            android:paddingRight="@dimen/rate_dialog_zero_dp"
            android:paddingBottom="@dimen/rate_dialog_zero_dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/rate_dialog_zero_dp"
            android:layout_marginTop="@dimen/rate_dialog_one_dp"
            android:layout_marginRight="@dimen/rate_dialog_zero_dp"
            android:layout_marginBottom="@dimen/rate_dialog_zero_dp"
            android:layout_below="@+id/rate_dialog_layout_head"
            android:animateLayoutChanges="true"
            android:layout_marginStart="@dimen/rate_dialog_zero_dp"
            android:layout_marginEnd="@dimen/rate_dialog_zero_dp">
            <com.google.android.material.button.MaterialButton
                android:textSize="14dp"
                android:textStyle="normal"
                android:textColor="@color/rateDialogColorApplePrimary"
                android:gravity="center"
                android:id="@+id/rate_dialog_button_negative"
                android:paddingLeft="@dimen/rate_dialog_zero_dp"
                android:paddingTop="@dimen/rate_dialog_zero_dp"
                android:paddingRight="@dimen/rate_dialog_zero_dp"
                android:paddingBottom="@dimen/rate_dialog_zero_dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="@dimen/rate_dialog_zero_dp"
                android:layout_marginRight="2dp"
                android:layout_marginBottom="@dimen/rate_dialog_zero_dp"
                android:text="@string/rate_dialog_no"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="2dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="14dp"
                android:textStyle="normal"
                android:textColor="@color/rateDialogColorApplePrimary"
                android:gravity="center"
                android:id="@+id/rate_dialog_button_neutral"
                android:paddingLeft="@dimen/rate_dialog_zero_dp"
                android:paddingTop="@dimen/rate_dialog_zero_dp"
                android:paddingRight="@dimen/rate_dialog_zero_dp"
                android:paddingBottom="@dimen/rate_dialog_zero_dp"
                android:focusable="true"
                android:visibility="visible"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="@dimen/rate_dialog_zero_dp"
                android:layout_marginRight="2dp"
                android:layout_marginBottom="@dimen/rate_dialog_zero_dp"
                android:text="@string/rate_dialog_cancel"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/logout_background"
                android:gravity="center"
                android:id="@+id/rate_dialog_button_positive"
                android:paddingLeft="@dimen/rate_dialog_zero_dp"
                android:paddingTop="@dimen/rate_dialog_zero_dp"
                android:paddingRight="@dimen/rate_dialog_zero_dp"
                android:paddingBottom="@dimen/rate_dialog_zero_dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/rate_dialog_zero_dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="@dimen/rate_dialog_zero_dp"
                android:text="@string/rate_dialog_ok"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/button_login_color"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
