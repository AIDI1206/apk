<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="end|bottom"
    android:id="@+id/linearLayout3"
    android:background="@color/tutorial_forcus_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.medicmedia.medilink.util.FTBOrigineBhavior">
    <androidx.cardview.widget.CardView
        android:gravity="center_vertical"
        android:id="@+id/innerquery_view"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="6dp"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="@color/normal_mode_ui_color"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/image_thumb"
                android:layout_width="116dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                android:maxHeight="50dp"
                android:layout_weight="0"
                android:layout_marginEnd="4dp"
                app:srcCompat="@drawable/ic_baseline_highlight_off_24px"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="4dp">
                <TextView
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/background_black"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/do_resume"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/background_black"
                    android:gravity="center_vertical"
                    android:id="@+id/resume_contents_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/do_resume"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/background_black"
                    android:gravity="center_vertical"
                    android:id="@+id/innerquery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="eeeeee"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/inner_search_delete"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:layout_marginEnd="10dp"
                app:srcCompat="@drawable/ic_baseline_cancel_24px"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
